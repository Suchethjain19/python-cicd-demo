pipeline {

    agent any
environment {
    AWS_REGION = 'eu-north-1'

    AWS_ACCOUNT_ID = '648597472772'

    ECR_REPO = '648597472772.dkr.ecr.eu-north-1.amazonaws.com/python-cicd-demo'

    ECS_CLUSTER = 'python-cicd-cluster'

    ECS_SERVICE = 'python-cicd-demo-service'

    TASK_DEFINITION = 'python-cicd-demo'

    CONTAINER_NAME = 'flask-app'
}
    stages {

        stage('Build') {
            steps {
                sh 'echo "===== BUILD STARTED ====="'
                sh 'whoami'
                sh 'pwd'
                sh 'ls -la'
                sh 'python3 --version'
                sh 'pip3 install -r requirements.txt'
                sh 'echo "===== BUILD SUCCESSFUL ====="'
            }
        }

        stage('Docker Build & Push') {
            steps {
                sh '''
                    echo "===== DOCKER BUILD ====="

                    docker build \
                        -t suchethjain19/python-cicd-demo:v2 .

                    echo "===== DOCKER PUSH ====="

                    docker push suchethjain19/python-cicd-demo:v2

                    echo "===== DOCKER PUSH SUCCESSFUL ====="
                '''
            }
        }

        stage('Deploy to EC2 #2') {
            steps {
                sshagent(credentials: ['app-server-key']) {
                    sh '''
                        echo "===== DEPLOYING TO EC2 #2 ====="

                        ssh -o StrictHostKeyChecking=no ec2-user@172.31.15.94 "
                            echo '===== PULLING IMAGE FROM DOCKER HUB =====' &&
                            docker pull suchethjain19/python-cicd-demo:v2 &&

                            echo '===== STOPPING OLD CONTAINER =====' &&
                            docker stop python-cicd-demo || true &&

                            echo '===== REMOVING OLD CONTAINER =====' &&
                            docker rm python-cicd-demo || true &&

                            echo '===== STARTING NEW CONTAINER =====' &&
                            docker run -d \
                                --name python-cicd-demo \
                                -p 8001:8000 \
                                suchethjain19/python-cicd-demo:v2 &&

                            echo '===== CONTAINER STARTED =====' &&
                            docker ps
                        "

                        echo "===== DEPLOYMENT SUCCESSFUL ====="
                    '''
                }
            }
        }
    }

    post {

        success {
            echo 'Pipeline Completed Successfully'
        }

        failure {
            echo 'Pipeline Failed'
        }

        always {
            echo 'Pipeline Finished'
        }
    }
}
