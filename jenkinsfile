
pipeline {

    agent any

    stages {

        stage('Build') {
            steps {
                sh 'echo "===== BUILD STARTED ====="'
                sh 'whoami'
                sh 'pwd'
                sh 'ls -la'
                sh 'python3 --version'
                sh 'pip3 install -r requirements.txt'
                sh 'echo "===== BUILD SUCCESSFUL ====="'
            }
        }

        stage('Docker Build & Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "===== DOCKER LOGIN ====="

                        printf '%s' "$DOCKER_PASSWORD" | docker login \
                            --username "$DOCKER_USERNAME" \
                            --password-stdin

                        echo "===== DOCKER BUILD ====="

                        docker build \
                            -t suchethjain19/python-cicd-demo:v2 .

                        echo "===== DOCKER PUSH ====="

                        docker push suchethjain19/python-cicd-demo:v2

                        echo "===== DOCKER PUSH SUCCESSFUL ====="
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                sshagent(credentials: ['app-server-key']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ec2-user@172.31.15.94 \
                        "cd /home/ec2-user/python-cicd-demo && \
                        git pull origin main && \
                        pip3 install -r requirements.txt && \
                        sudo systemctl restart flask-app && \
                        sudo systemctl status flask-app --no-pager"
                    '''
                }
            }
        }
    }

    post {

        success {
            echo 'Pipeline Completed Successfully'
        }

        failure {
            echo 'Pipeline Failed'
        }

        always {
            echo 'Pipeline Finished'
        }
    }
}
