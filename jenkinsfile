pipeline {

    agent any

    environment {
        AWS_REGION = 'eu-north-1'

        ECR_REPO = '648597472772.dkr.ecr.eu-north-1.amazonaws.com/python-cicd-demo'

        ECS_CLUSTER = 'python-cicd-cluster'

        ECS_SERVICE = 'python-cicd-demo-service'

        TASK_DEFINITION = 'python-cicd-demo'

        CONTAINER_NAME = 'flask-app'
    }

    stages {

        stage('Build') {
            steps {
                sh '''
                    echo "===== BUILD STARTED ====="

                    whoami
                    pwd
                    ls -la
                    python3 --version

                    pip3 install -r requirements.txt

                    echo "===== BUILD SUCCESSFUL ====="
                '''
            }
        }

        stage('ECR Login') {
            steps {
                sh '''
                    echo "===== ECR LOGIN ====="

                    aws ecr get-login-password \
                        --region $AWS_REGION | \
                    docker login \
                        --username AWS \
                        --password-stdin $ECR_REPO

                    echo "===== ECR LOGIN SUCCESSFUL ====="
                '''
            }
        }

        stage('Docker Build & Push') {
            steps {
                sh '''
                    echo "===== DOCKER BUILD ====="

                    docker build \
                        -t $ECR_REPO:$BUILD_NUMBER .

                    echo "===== DOCKER PUSH ====="

                    docker push \
                        $ECR_REPO:$BUILD_NUMBER

                    echo "===== ECR PUSH SUCCESSFUL ====="
                '''
            }
        }

        stage('Create ECS Task Definition') {
            steps {
                sh '''
                    echo "===== GETTING CURRENT TASK DEFINITION ====="

                    aws ecs describe-task-definition \
                        --task-definition $TASK_DEFINITION \
                        --region $AWS_REGION \
                        --query taskDefinition \
                        --output json > task-definition.json

                    echo "===== CREATING NEW TASK DEFINITION ====="

                    jq --arg IMAGE "$ECR_REPO:$BUILD_NUMBER" '
                        {
                            family: .family,
                            taskRoleArn: .taskRoleArn,
                            executionRoleArn: .executionRoleArn,
                            networkMode: .networkMode,
                            containerDefinitions: .containerDefinitions,
                            volumes: .volumes,
                            placementConstraints: .placementConstraints,
                            requiresCompatibilities: .requiresCompatibilities,
                            cpu: .cpu,
                            memory: .memory,
                            runtimePlatform: .runtimePlatform,
                            proxyConfiguration: .proxyConfiguration,
                            pidMode: .pidMode,
                            ipcMode: .ipcMode,
                            inferenceAccelerators: .inferenceAccelerators,
                            ephemeralStorage: .ephemeralStorage
                        }
                        | .containerDefinitions[0].image = $IMAGE
                        | with_entries(select(.value != null))
                    ' task-definition.json > new-task-definition.json

                    echo "===== NEW IMAGE ====="

                    jq '.containerDefinitions[0].image' new-task-definition.json

                    echo "===== REGISTERING NEW TASK DEFINITION ====="

                    aws ecs register-task-definition \
                        --cli-input-json file://new-task-definition.json \
                        --region $AWS_REGION

                    echo "===== TASK DEFINITION REGISTERED ====="
                '''
            }
        }

        stage('Deploy to ECS') {
            steps {
                sh '''
                    echo "===== GETTING NEW TASK DEFINITION REVISION ====="

                    NEW_REVISION=$(aws ecs describe-task-definition \
                        --task-definition $TASK_DEFINITION \
                        --region $AWS_REGION \
                        --query 'taskDefinition.revision' \
                        --output text)

                    echo "NEW TASK DEFINITION REVISION: $NEW_REVISION"

                    echo "===== UPDATING ECS SERVICE ====="

                    aws ecs update-service \
                        --cluster $ECS_CLUSTER \
                        --service $ECS_SERVICE \
                        --task-definition $TASK_DEFINITION:$NEW_REVISION \
                        --region $AWS_REGION

                    echo "===== ECS DEPLOYMENT STARTED ====="
                '''
            }
        }
    }

    post {

        success {
            echo 'Pipeline Completed Successfully'
        }

        failure {
            echo 'Pipeline Failed'
        }

        always {
            echo 'Pipeline Finished'
        }
    }
}

   
